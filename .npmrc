# React Native / Expo ne supporte pas les node_modules symlinkés de pnpm :
# Metro ne résout pas les liens. node-linker=hoisted recrée un arbre plat
# (comportement npm) — condition de survie du mobile dans le monorepo pnpm.
node-linker=hoisted
# Évite les soucis de peer deps stricts sur l'écosystème Expo/RN.
strict-peer-dependencies=false
