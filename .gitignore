# === MaSante / IVOIRSANTÉ — gitignore racine (monorepo) ===

# Secrets : ne JAMAIS committer (§6.2 doc Sécurité)
**/.env
**/.env.*.local
*.pem
*.key

# Dépendances
**/vendor/
**/node_modules/

# Laravel (backend) — déplacé en services/api (réorg monorepo ADR-003)
services/api/storage/*.key
services/api/.phpunit.result.cache
services/api/storage/framework/cache/data/*
services/api/storage/framework/sessions/*
services/api/storage/framework/views/*
services/api/storage/logs/*
services/api/public/storage
services/api/bootstrap/cache/*.php
services/api/database/database.sqlite

# Ancien emplacement (résidu verrouillé à nettoyer quand le process php le relâche)
ivoirsante-api/

# Expo / React Native (mobile) — déplacé en apps/mobile
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/*.log

# Monorepo
pnpm-lock.yaml.bak
**/.next/
**/.turbo/
*.tsbuildinfo

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Fichiers temporaires d'analyse
_*.txt

# Boîte à outils externe (pas du code projet)
claude-skills-main/

# Préférences locales Claude Code (personnelles)
.claude/settings.local.json
