  "referentiels_internes": {
    "SIGNES_GRAVITE_OMS": {
      "cliniques": [
        {
          "code": "GRAV_CONSCIENCE",
          "libelle": "Troubles de la conscience (Glasgow < 11 ou Blantyre < 3)"
        },
        {
          "code": "GRAV_PROSTRATION",
          "libelle": "Prostration : incapacité à s'asseoir ou se tenir debout sans aide"
        },
        {
          "code": "GRAV_CONVULSIONS",
          "libelle": "Convulsions répétées (> 2 en 24 heures)"
        },
        {
          "code": "GRAV_DETRESSE_RESP",
          "libelle": "Respiration profonde / détresse respiratoire"
        },
        {
          "code": "GRAV_OAP",
          "libelle": "Œdème pulmonaire avec hypoxie"
        },
        {
          "code": "GRAV_COLLAPSUS",
          "libelle": "Collapsus cardiovasculaire / état de choc"
        },
        {
          "code": "GRAV_OLIGOANURIE",
          "libelle": "Oligurie ou anurie"
        },
        {
          "code": "GRAV_SAIGNEMENT",
          "libelle": "Saignements anormaux"
        }
      ],
      "biologiques": [
        {
          "code": "GRAV_HYPOGLYCEMIE",
          "libelle": "Hypoglycémie",
          "seuil": "< 2,2 mmol/L"
        },
        {
          "code": "GRAV_ACIDOSE",
          "libelle": "Acidose métabolique",
          "seuil": "bicarbonates < 15 mmol/L"
        },
        {
          "code": "GRAV_ANEMIE_SEVERE",
          "libelle": "Anémie sévère"
        },
        {
          "code": "GRAV_HEMOGLOBINURIE",
          "libelle": "Hémoglobinurie"
        },
        {
          "code": "GRAV_HYPERLACTATEMIE",
          "libelle": "Hyperlactatémie",
          "seuil": "> 5 mmol/L"
        },
        {
          "code": "GRAV_IRA",
          "libelle": "Insuffisance rénale aiguë"
        },
        {
          "code": "GRAV_ICTERE",
          "libelle": "Ictère avec parasitémie",
          "seuil": "> 10 000/µL"
        },
        {
          "code": "GRAV_HYPERPARASITEMIE",
          "libelle": "Hyperparasitémie",
          "seuil": "> 10 %"
        }
      ]
    }
  },
  "regles": [
    {
      "id": "R01",
      "priorite": 1,
      "libelle": "Signes de gravité — urgence absolue",
      "condition": "signes_gravite.length > 0",
      "actions": [
        {
          "type": "CLASSIFICATION",
          "valeur": "PALUDISME_GRAVE_SUSPECT"
        },
        {
          "type": "ORIENTATION",
          "valeur": "REFERENCE_URGENTE"
        },
        {
          "type": "TRAITEMENT_PRE_TRANSFERT",
          "ref": "TRT_PRE_TRANSFERT"
        }
      ],
      "niveau_preuve": "A",
      "annotation": "Ne pas retarder la référence pour réaliser un TDR."
    },
    {
      "id": "R02",
      "priorite": 2,
      "libelle": "Confirmation parasitologique obligatoire avant traitement",
      "condition": "fievre_ou_antecedent_fievre == true ET signes_gravite.length == 0 ET resultat_tdr == 'NON_REALISE' ET resultat_goutte_epaisse == 'NON_REALISE'",
      "actions": [
        {
          "type": "EXAMEN",
          "valeur": "TDR_PALUDISME"
        },
        {
          "type": "BLOCAGE_PRESCRIPTION",
          "message": "Aucun antipaludique avant confirmation parasitologique."
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R03",
      "priorite": 3,
      "libelle": "Paludisme simple confirmé",
      "condition": "(resultat_tdr == 'POSITIF' OU resultat_goutte_epaisse == 'POSITIF') ET signes_gravite.length == 0",
      "actions": [
        {
          "type": "CLASSIFICATION",
          "valeur": "PALUDISME_SIMPLE_CONFIRME"
        },
        {
          "type": "TRAITEMENT",
          "ref": "TRT_CTA_1ERE_INTENTION"
        },
        {
          "type": "SUIVI",
          "valeur": "J3_J7_J14"
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R04",
      "priorite": 3,
      "libelle": "Test négatif — chercher une autre cause",
      "condition": "resultat_tdr == 'NEGATIF' ET signes_gravite.length == 0",
      "actions": [
        {
          "type": "CLASSIFICATION",
          "valeur": "PALUDISME_ECARTE"
        },
        {
          "type": "ORIENTATION",
          "valeur": "RECHERCHE_AUTRE_ETIOLOGIE_FIEVRE"
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R05",
      "priorite": 2,
      "libelle": "Grossesse 1er trimestre — CTA contre-indiquées (paludisme simple)",
      "condition": "grossesse == true ET trimestre_grossesse == 'T1' ET classification == 'PALUDISME_SIMPLE_CONFIRME'",
      "actions": [
        {
          "type": "TRAITEMENT",
          "ref": "TRT_QUININE_ORALE_5J"
        },
        {
          "type": "ALERTE",
          "message": "Paludisme chez la femme enceinte = urgence médicale."
        }
      ],
      "remplace": [
        "R03"
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R06",
      "priorite": 2,
      "libelle": "TPIg — traitement préventif intermittent chez la femme enceinte",
      "condition": "grossesse == true ET semaines_amenorrhee >= 16 ET sous_cotrimoxazole == false",
      "actions": [
        {
          "type": "PREVENTION",
          "medicament": "SULFADOXINE_PYRIMETHAMINE",
          "posologie": "3 comprimés en prise unique, mensuelle jusqu'à l'accouchement",
          "modalite": "TDO — traitement directement observé en CPN"
        },
        {
          "type": "PRECAUTION",
          "message": "Suspendre l'acide folique > 5 mg/j ; reprise 15 jours après la dose de SP."
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R07",
      "priorite": 2,
      "libelle": "Contre-indication SP sous cotrimoxazole",
      "condition": "grossesse == true ET sous_cotrimoxazole == true",
      "actions": [
        {
          "type": "CONTRE_INDICATION",
          "medicament": "SULFADOXINE_PYRIMETHAMINE",
          "motif": "Risque de surdosage"
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R08",
      "priorite": 2,
      "libelle": "Interaction ARV — éviter AS+AQ",
      "condition": "traitement_arv contient 'EFAVIRENZ' OU traitement_arv contient 'ZIDOVUDINE'",
      "actions": [
        {
          "type": "CONTRE_INDICATION_RELATIVE",
          "medicament": "ARTESUNATE_AMODIAQUINE",
          "motif": "Interaction avec éfavirenz / zidovudine"
        },
        {
          "type": "ALTERNATIVE",
          "ref": "TRT_CTA_1ERE_INTENTION",
          "exclure": [
            "AS_AQ"
          ]
        }
      ],
      "niveau_preuve": "B"
    },
    {
      "id": "R09",
      "priorite": 4,
      "libelle": "Fièvre élevée — traitement adjuvant",
      "condition": "temperature_c > 38.5",
      "actions": [
        {
          "type": "TRAITEMENT_ADJUVANT",
          "medicament": "PARACETAMOL",
          "posologie": "15 mg/kg toutes les 6 h",
          "maximum": "80 mg/kg/j (enfant) — 3 g/j (adulte)"
        },
        {
          "type": "CONTRE_INDICATION",
          "medicament": "ASPIRINE_ET_AINS"
        }
      ],
      "niveau_preuve": "A"
    },
    {
      "id": "R10",
      "priorite": 3,
      "libelle": "Échec thérapeutique",
      "condition": "parasitemie_persistante_j3 == true OU reapparition_parasites == true",
      "actions": [
        {
          "type": "EVALUATION",
          "valeur": "VERIFIER_OBSERVANCE"
        },
        {
          "type": "EXAMEN",
          "valeur": "GOUTTE_EPAISSE_CONTROLE"
        },
        {
          "type": "ARBRE_DECISION",
          "ref": "ARBRE_ECHEC_THERAPEUTIQUE"
        },
        {
          "type": "ALERTE",
          "message": "Échec thérapeutique : ne pas reconduire la 1ère intention sans appliquer l'arbre de décision."
        }
      ],
      "niveau_preuve": "B",
      "remplace": [
        "R03"
      ]
    },
    {
      "id": "R11",
      "priorite": 1,
      "libelle": "Nourrisson de très faible poids — pas de posologie automatique",
      "condition": "poids_kg < 4.5 OU age_mois < 2",
      "actions": [
        {
          "type": "BLOCAGE_PRESCRIPTION",
          "message": "Poids ou âge sous le plancher de dosage automatique : posologie à déterminer par un médecin."
        },
        {
          "type": "ORIENTATION",
          "valeur": "AVIS_MEDICAL_OBLIGATOIRE"
        }
      ],
      "niveau_preuve": "garde_fou_technique",
      "annotation": "Règle de sécurité du moteur, pas une recommandation du guide national."
    }
  ],
