    "TRT_PALUDISME_GRAVE": {
      "libelle": "Paludisme grave — traitement parentéral",
      "premiere_intention": {
        "code": "ARTESUNATE_INJECTABLE",
        "libelle": "Artésunate injectable (IV ou IM)",
        "posologie": [
          {
            "population": "Adulte et enfant ≥ 20 kg",
            "dose": "2,4 mg/kg"
          },
          {
            "population": "Enfant < 20 kg",
            "dose": "3 mg/kg"
          },
          {
            "population": "Femme enceinte",
            "dose": "2,4 mg/kg"
          }
        ],
        "schema": "J1 : H0, H12, H24 (3 doses) — puis 1 dose/jour de J2 à J7",
        "relais_oral": "Dès que le patient tolère la voie orale et après au moins 24 h (3 doses) : CTA pendant 3 jours"
      },
      "alternatives": [
        {
          "code": "ARTEMETHER_IM",
          "posologie": "J1 : 1,6 mg/kg à H0 et H12 — J2 à J7 : 1,6 mg/kg une fois par jour",
          "duree_jours": 7
        },
        {
          "code": "QUININE_IV",
          "posologie": "J1 : 8 mg/kg × 3 perfusions (24 mg/kg) — J2 à J5 : 12 mg/kg × 2 perfusions (24 mg/kg)",
          "duree_jours": 5
        }
      ],
      "alerte_interaction": "Ne pas associer quinine, CTA, statines et fluoroquinolones — risque de cardiotoxicité et d'hypoglycémie. Espacer de 12 à 24 h si indispensable."
    },
    "TRT_PRE_TRANSFERT": {
      "libelle": "Traitement pré-transfert avant référence urgente",
      "options": [
        {
          "population": "Enfant 0–5 ans (< 20 kg)",
          "choix": [
            {
              "medicament": "ARTESUNATE_RECTAL",
