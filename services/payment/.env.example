# ─────────────────────────────────────────────────────────────────────────────
# services/payment — secrets de la pile de développement (micro-lot B4)
# ─────────────────────────────────────────────────────────────────────────────
# Ce fichier est VERSIONNÉ et doit rester VIDE de toute valeur. Copiez-le en `.env`
# (ignoré par git, deux fois : `**/.env` à la racine et `.env` ici) et renseignez-le.
#
# `docker-compose.yml` lit ce `.env` automatiquement et REFUSE de démarrer si l'une de ces
# variables est absente ou vide (syntaxe `${VAR:?...}`) : un secret manquant doit faire échouer
# bruyamment le démarrage, jamais laisser la pile monter avec une chaîne vide.

# Mot de passe PostgreSQL. UNE seule variable pour le serveur ET le client : deux variables
# distinctes pourraient diverger et casser la connexion sans que rien ne l'annonce.
PAYMENT_DB_PASSWORD=

# Chiffrement des destinations de reversement (AES-256-GCM) et poivre HMAC de leurs empreintes
# (P5.5b-1). Base64. En production : KMS + `masante.payment.securite.exiger-cles=true`.
MASANTE_PAYMENT_DEST_KEY=
MASANTE_PAYMENT_DEST_PEPPER=

# Secret du principal signé — PARTAGÉ à l'identique avec le backend Laravel et apps/web.
# Sert dans les DEUX sens : vérification entrante (ServicePrincipal) et signature sortante
# (SigneurPrincipalSortant, lot 6). Base64.
MASANTE_PAYMENT_PRINCIPAL_SECRET=

# ── GeniusPay (lot 7) ────────────────────────────────────────────────────────
# Base retenue par la vérification V1 du 2026-08-28 : les DEUX bases répondent 200, la règle de
# départage de l'arbitrage tranche pour geniuspay.ci (Cloudflare, ~3x plus rapide). JAMAIS en dur
# dans le code — §6.1 du prompt v2.
GENIUSPAY_BASE_URL=https://geniuspay.ci
# Clés marchandes sandbox. En montage A, chaque établissement a les siennes, chiffrées en base
# (§6.2) ; celles-ci sont les clés de test du compte de démonstration.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
