# =====================================================================
# MaSante / IVOIRSANTÉ — API Laravel — fichier d'exemple (.env.example)
# Copier en .env puis renseigner les valeurs. NE JAMAIS committer le .env réel
# ni un secret réel ici. (Document Sécurité §6.2 : les clés ne vivent jamais
# dans le dépôt Git.)
# =====================================================================

APP_NAME="MaSante"
APP_ENV=local
# Générer avec : php artisan key:generate  (sert aussi de clé AES-256, §6 doc Sécurité)
APP_KEY=
# Secret de signature des QR Code dynamiques (Module 2, Sécurité §5.2). Distinct de APP_KEY.
# Générer avec : php -r "echo 'base64:'.base64_encode(random_bytes(32));"
QR_SECRET=
# APP_DEBUG : true en dev UNIQUEMENT. TOUJOURS false en prod/soutenance (§7.3).
APP_DEBUG=true
# En dev : http://localhost:8000 ; en test mobile : l'URL HTTPS Ngrok du moment.
APP_URL=http://localhost:8000

# URL publique HTTPS du tunnel Ngrok du moment (utilisée par CORS — §4.3 / §7.3).
# À mettre à jour à chaque relance de ngrok. Vide => CORS autorise tout (DEV ONLY).
FRONTEND_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données : MySQL 8.4 (WAMP) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivoirsante
DB_USERNAME=root
# Mot de passe MySQL local (laisser vide si root sans mot de passe).
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@masante.ci"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Module 5.8 — OCR du reçu de pharmacie (FN7 « scan de reçu »).
# Tesseract est AUTO-HÉBERGÉ : un reçu dit quels médicaments une personne a achetés (donnée de
# santé, loi n°2013-450) — il ne part pas chez un OCR en ligne. Prérequis d'installation :
#   1. winget install --id UB-Mannheim.TesseractOCR
#   2. télécharger fra.traineddata + eng.traineddata (tessdata_fast) dans storage/app/tessdata/
# Sans ces deux étapes, l'endpoint /api/v1/recus/lecture renvoie 503 et le mobile bascule
# proprement sur la saisie manuelle du prix (dégradation prévue, pas une panne).
MASANTE_TESSERACT_BIN="C:\Program Files\Tesseract-OCR\tesseract.exe"
MASANTE_TESSERACT_LANG=fra

# ─────────────────────────────────────────────────────────────────────────────
# PKI et signature électronique (P6.5b — CDC_09 §5.3, CDC_10 §4)
# ─────────────────────────────────────────────────────────────────────────────
#
# Phrase de passe de l'autorité de certification racine. AUCUNE VALEUR PAR DÉFAUT n'est fournie
# dans le code : une valeur de repli serait un secret du dépôt, et pire, un secret que tout le
# monde croirait avoir remplacé (CDC_10 §5). Absente, la création de l'autorité échoue
# bruyamment — c'est le comportement voulu.
#
# Elle protège la clé de l'AUTORITÉ, pas celles des praticiens : chaque clé privée de
# professionnel est scellée par le secret de son porteur, que le serveur ne connaît pas.
PKI_CA_PASSPHRASE=

# Identité de l'autorité (facultatif — valeurs par défaut dans config/pki.php).
# PKI_CA_NOM="MaSante Autorite Racine"
# PKI_CA_ORGANISATION=MaSante
# PKI_CA_PAYS=CI

# Durée de vie d'un certificat de professionnel, en jours (défaut 730).
# PKI_CERT_VALIDITE_JOURS=730

# Secret de signature du praticien : longueur minimale, seuil et durée du verrou temporaire.
# PKI_SECRET_LONGUEUR_MIN=8
# PKI_SECRET_ECHECS=5
# PKI_SECRET_VERROU_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# Socle d'intégration `triage-service` — P10c-2-i (F7/F8)
# ─────────────────────────────────────────────────────────────────────────────
# Aucun secret ici : ce service n'est pas authentifié (motif dans ClientTriageIa — même régime que
# le /score en signaux fournis de fraud-detection). GATÉ OFF par défaut : appeler à chaque triage un
# service qui répond toujours « pas de modèle » (F5/F6) ajouterait une latence pour rien tant que
# P10c-3 n'a livré aucun modèle.
# TRIAGE_IA_ENABLED=false
# TRIAGE_IA_BASE_URL=http://triage-service:8095
# TRIAGE_IA_TIMEOUT_CONNEXION=2
# TRIAGE_IA_TIMEOUT_LECTURE=3
# TRIAGE_IA_DISJONCTEUR_SEUIL=3
# TRIAGE_IA_DISJONCTEUR_DUREE=60
